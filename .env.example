# =====================================================================================
# DEVELOPMENT-ONLY configuration for the M01 + M10 hub Rust prototype. Copy to .env and adjust.
# Every password below is a development placeholder — change them for any shared use.
# =====================================================================================

APP_ENV=development
APP_BIND_ADDR=0.0.0.0:3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
# Set to false for benchmark runs to measure without per-request log I/O.
ACCESS_LOG=true

# ---- Central (Scicom control-plane) PostgreSQL -- Docker publishes it on localhost:55432 ----
POSTGRES_OWNER_PASSWORD=dev-owner-password-change-me
CRM_APP_PASSWORD=dev-app-password-change-me
# Runtime role (crm_app, NOBYPASSRLS, not owner):
DATABASE_URL=postgres://crm_app:dev-app-password-change-me@localhost:55432/omni_control
# Owner role (migrations + tenant schema DDL only):
MIGRATION_DATABASE_URL=postgres://crm_owner:dev-owner-password-change-me@localhost:55432/omni_control
DB_MAX_CONNECTIONS=20
RUN_MIGRATIONS=true

# ---- Dedicated tenant database targets (Regulated tier) ----
TENANT_DB_TARGETS_FILE=config/tenant-db-targets.local.toml
TENANT_DB_PG_ADMIN_PASSWORD=dev-tenant-pg-admin-change-me
TENANT_DB_MYSQL_ADMIN_PASSWORD=dev-tenant-mysql-root-change-me
# Seed for per-tenant runtime DB logins (HMAC-derived; stand-in for vault dynamic credentials).
TENANT_DB_RUNTIME_SEED=dev-runtime-credential-seed-change-me

# ---- Bootstrap Super Admin (seeded at first start when absent) ----
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@omni.local
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe-SuperAdmin-2026!

# ---- Local reference KMS master key (base64, 32 bytes). Development only. ----
# Regenerate with: head -c 32 /dev/urandom | base64
LOCAL_KMS_MASTER_KEY=PXVoOP25J9fimGiorQ/uVna8P08sxHmmU+U4UCFrm9I=

# ---- Misc ----
DATA_DIR=./data
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
API_TOKEN_TTL_MINUTES=60
PLATFORM_DOMAIN=tenants.omni.local
# Simulated DNS / SPF-DKIM verifier: domains with these suffixes verify successfully.
SIMULATED_VERIFIED_DOMAIN_SUFFIXES=.verified.test

# ---- Lifecycle timers (hours). Development: purge allowed immediately after termination,
# auto-purge off so the purge can be exercised from the UI. Production: e.g. 720 / 2160 / true.
LIFECYCLE_GRACE_PERIOD_HOURS=720
LIFECYCLE_RETENTION_HOURS=0
LIFECYCLE_AUTO_PURGE=false
LIFECYCLE_SCHEDULER_ENABLED=true
LIFECYCLE_SCHEDULER_INTERVAL_SECS=30

# ---- M10 omnichannel hub (gateway slice) ----
# Redis = cross-node real-time bus. Docker publishes it on localhost:56379. Leave empty to run a
# single node with the in-process bus.
REDIS_URL=redis://localhost:56379
# Unique per node (defaults to the container hostname).
NODE_ID=local
# ---- WhatsApp (ADR-0013) --------------------------------------------------------------
# fake = the fake-meta server (imitation of Meta's API, NOT WhatsApp; no credentials needed;
#        bulk load tests). meta = real WhatsApp Cloud API (sandbox test number or production).
WHATSAPP_PROVIDER=fake
# Real Meta (used only when WHATSAPP_PROVIDER=meta) — from developers.facebook.com → your app →
# WhatsApp → API Setup, and App settings → Basic (App secret). Keep these out of git and chat.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_GRAPH_API_VERSION=v25.0
# Outbound pace per business number (Meta's base tier is 80/s; raise only if your number's tier allows).
WHATSAPP_SEND_RATE_PER_SEC=80
# Optional but recommended: with both IDs the hub registers its webhook in Meta by itself at
# startup (no manual Meta settings). App ID: app dashboard / App settings → Basic. WhatsApp
# Business Account ID: WhatsApp → API Setup, next to the Phone number ID.
WHATSAPP_APP_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any word; the hub uses it in Meta's webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# Public HTTPS address so Meta can reach the webhook. Easiest: COMPOSE_PROFILES=tunnel (cloudflared,
# no account; Docker Compose reads this variable from .env). Fixed address: COMPOSE_PROFILES=tunnel-ngrok
# plus NGROK_AUTHTOKEN and NGROK_DOMAIN from your free ngrok account. Own tunnel: WHATSAPP_PUBLIC_BASE_URL.
COMPOSE_PROFILES=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
WHATSAPP_PUBLIC_BASE_URL=
# fake-meta (used when WHATSAPP_PROVIDER=fake). Docker publishes it on localhost:58090; inside
# Docker Compose the app uses http://fake-meta:8090.
FAKE_META_URL=http://localhost:58090
FAKE_META_ACCESS_TOKEN=fake-meta-dev-token
FAKE_META_APP_SECRET=fake-meta-dev-app-secret
# Simulated SBC (voice) event feed secret.
HUB_SIM_SIP_SECRET=dev-sim-sip-secret-change-me
# Development only: create tenant "demo" with a Tenant Admin, three agents and simulated channels.
#   Tenant Admin  admin@demo.omni.local           (organisation code: demo)
#   Agents        agent.sales@demo.omni.local     (skill: sales)
#                 agent.support@demo.omni.local   (skill: support)
#                 agent.lead@demo.omni.local      (skills: sales, support)
# All use HUB_DEMO_PASSWORD.
HUB_DEMO_SEED=true
HUB_DEMO_PASSWORD=Demo-Hub-Passw0rd!
